# TechGuessr — variables de entorno de referencia
#
# IMPORTANTE: Este archivo es solo documentación/referencia local para el
# equipo. Ni la AWS CLI ni AWS CDK leen un archivo .env automáticamente.
# El mecanismo real para autenticar CDK/AWS CLI es:
#
#   aws configure --profile techguessr
#
# Eso guarda las credenciales en ~/.aws/credentials (fuera de este repo) y
# ~/.aws/config. Para desplegar con ese perfil:
#
#   $env:AWS_PROFILE = "techguessr"   (PowerShell)
#   npx cdk deploy --all
#
# Copia este archivo a ".env" solo si necesitas anotar las credenciales
# localmente por algún motivo puntual. NUNCA hagas commit del archivo ".env"
# real (ya está excluido en .gitignore). No compartas el Secret Access Key
# por chat, email ni lo pegues en ningún archivo que se vaya a subir a Git.

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
AWS_PROFILE=techguessr

# IDs de recursos desplegados (se completan después del primer `cdk deploy`,
# ver los CfnOutput de cada stack: UserPoolId, UserPoolClientId, ApiUrl,
# DistributionDomainName).
COGNITO_USER_POOL_ID=
COGNITO_USER_POOL_CLIENT_ID=
API_BASE_URL=
CLOUDFRONT_DOMAIN=
